# Production Environment Variables Template

SECRET_KEY=SECRET_KEY

# Email-Konfiguration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=example@gmail.com
RECIPIENT_EMAIL=example@gmail.com
EMAIL_HOST_PASSWORD=email_password
DEFAULT_FROM_EMAIL=noreply@example.com

# Debug-Modus (MUSS False sein in Production)
DEBUG=False

# Datenbank fÃ¼r Production
DATABASE_URL=postgresql://user:password@db:5432/dbname

# Production-Einstellungen
DJANGO_ENV=production
ALLOWED_HOSTS=example.ch,www.example.ch,wa-generator.example.ch,localhost,127.0.0.1,192.168.1.28


# Sicherheits-Einstellungen fÃ¼r Production
SECURE_SSL_REDIRECT=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# Logging Level
LOG_LEVEL=WARNING
