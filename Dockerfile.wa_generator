# syntax=docker/dockerfile:1

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=wa_automater.settings

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY ./wa_automater/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Copy wa_automater app
COPY ./wa_automater /app

# Copy Python_Back_End modules (needed for CustomsList and t1_reader)
COPY ./Python_Back_End /app/Python_Back_End

RUN mkdir -p /app/staticfiles /app/media /app/data

# Check Django setup
RUN python manage.py check

# Run migrations (try, but don't fail the build)
RUN python manage.py migrate --noinput || true
RUN python manage.py collectstatic --noinput || true

EXPOSE 8000

CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "120", "wa_automater.wsgi:application"]