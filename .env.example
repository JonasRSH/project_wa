# Gemeinsame Variablen fuer beide Module

# ===== Website (jonasrsh.github.io) =====
SECRET_KEY=change-me
WEBSITE_DEBUG=False
WEBSITE_DATABASE_URL=sqlite:////app/data/db.sqlite3
ALLOWED_HOSTS=jonashuggler.ch,www.jonashuggler.ch,localhost,127.0.0.1

# Email-Konfiguration (Website)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=example@gmail.com
EMAIL_HOST_PASSWORD=email_password
DEFAULT_FROM_EMAIL=noreply@example.com

# ===== WA Generator (wa_automater) =====
WA_SECRET_KEY=change-me
WA_DEBUG=False
WA_ALLOWED_HOSTS=wa-generator.jonashuggler.ch,localhost,127.0.0.1
WA_CSRF_TRUSTED_ORIGINS=https://wa-generator.jonashuggler.ch,http://localhost

# Optional: Logging
LOG_LEVEL=WARNING


